rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/home).data.memberUids;
    }
    function validFood(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['uuid','foodName','foodType','amount','expiryDate','tips','revision']) &&
        d.keys().hasOnly(['uuid','foodName','foodType','amount','expiryDate','tips','revision']) &&
        d.uuid == id &&
        id.matches('[0-9a-fA-F-]{36}') &&
        d.foodName is string && d.foodName.size() > 0 && d.foodName.size() <= 200 &&
        d.foodType is string && d.foodType.size() <= 100 &&
        d.amount is int && d.amount >= 1 && d.amount <= 100000 &&
        d.expiryDate is string && d.expiryDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        d.tips is string && d.tips.size() <= 2000 &&
        d.revision is int && d.revision >= 1;
    }
    match /households/home {
      allow read: if isMember();
      // Membership is managed exclusively in the Firebase console.
      allow write: if false;
      match /foods/{id} {
        allow read: if isMember();
        allow create: if isMember() && validFood(id) && request.resource.data.revision == 1;
        allow update: if isMember() && validFood(id) &&
          request.resource.data.revision == resource.data.revision + 1;
        allow delete: if isMember();
      }
    }
  }
}
